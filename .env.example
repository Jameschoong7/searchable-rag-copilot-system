# Searchable RAG Copilot configuration template.
# Copy this file to .env and replace placeholders locally.
# Never commit .env, access keys, connection strings, or access tokens.

# -----------------------------------------------------------------------------
# Shared local application settings
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral

# Local embeddings are required for both ChromaDB and Azure AI Search.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BACKEND=local

CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION_NAME=rag_documents
DOCUMENTS_PATH=./data/simulated

API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Select local or Azure-backed providers.
# Local profile: local / chroma / ollama
# Hybrid profile: azure_blob / azure_search / azure_openai
STORAGE_BACKEND=local
VECTOR_BACKEND=chroma
LLM_BACKEND=ollama

# Retrieval defaults. Portal-saved SQLite settings override these values.
TOP_K=5
MINIMUM_RELEVANCE_THRESHOLD=0.25
GUARDRAIL_PROMPT=Answer only from authorised retrieved documents. If the answer is missing or restricted, say so clearly.

# -----------------------------------------------------------------------------
# Azure Blob Storage - required only when STORAGE_BACKEND=azure_blob
# Azure portal: Storage account > Security + networking > Access keys
# -----------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=<AZURE_STORAGE_CONNECTION_STRING>
AZURE_STORAGE_CONTAINER_NAME=kb-documents

# -----------------------------------------------------------------------------
# Azure AI Search - required only when VECTOR_BACKEND=azure_search
# Endpoint: Search service > Overview
# Key: Search service > Settings > Keys
# -----------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://<SEARCH_SERVICE_NAME>.search.windows.net
AZURE_SEARCH_ADMIN_KEY=<AZURE_SEARCH_ADMIN_KEY>
AZURE_SEARCH_INDEX_NAME=rag-copilot-documents

# -----------------------------------------------------------------------------
# Microsoft Graph delegated read connector
# Do not normally set GRAPH_ACCESS_TOKEN. Use scripts/graph_device_login.py so
# MSAL can cache and silently refresh delegated tokens.
# -----------------------------------------------------------------------------
GRAPH_CONNECTOR_ENABLED=false
GRAPH_CLIENT_ID=<ENTRA_APPLICATION_CLIENT_ID>

# Current personal-account setup:
GRAPH_AUTHORITY=https://login.microsoftonline.com/consumers
# Company single-tenant alternative:
# GRAPH_AUTHORITY=https://login.microsoftonline.com/<TENANT_ID>

GRAPH_SCOPES=User.Read Files.Read Notes.Read
GRAPH_ONEDRIVE_ROOT_PATH=/Enterprise Knowledge Base
GRAPH_ONENOTE_NOTEBOOK_FILTER=Enterprise Knowledge Base
# GRAPH_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Azure OpenAI-compatible Foundry endpoint
# Foundry deployment details provide the endpoint, key, and deployment name.
# -----------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=<AZURE_OPENAI_API_KEY>
AZURE_OPENAI_ENDPOINT=https://<FOUNDRY_RESOURCE_NAME>.services.ai.azure.com/openai/v1
AZURE_OPENAI_CHAT_DEPLOYMENT=rag-gpt-5.4-nano
